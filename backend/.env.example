# Copy this file to .env and fill in the values.
# Never commit .env — it is gitignored.
#
#   cp .env.example .env

# MongoDB connection string
# Local:   mongodb://127.0.0.1:27017/ventaOnline
# Atlas:   mongodb+srv://<user>:<pass>@cluster.mongodb.net/ventaOnline
MONGO_URI=mongodb://127.0.0.1:27017/ventaOnline

# JWT signing secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Server port (default: 3200)
PORT=3200

# Allowed CORS origin for production (default: * — open to all)
# Example: https://myapp.com
CORS_ORIGIN=
